{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local MLX)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "omlx-local"
      },
      "models": {
        "gemma-4-e4b-mlx": {
          "name": "Gemma 4 E4B (fast)"
        },
        "qwen3.6-27b-4bit": {
          "name": "Qwen3.6 27B (DFlash)"
        }
      }
    },
    "mlxcluster": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Cluster (M5 + M4)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local-mlx-cluster",
        "timeout": 600000
      },
      "models": {}
    }
  },
  "model": "omlx/qwen3.6-27b-4bit"
}
