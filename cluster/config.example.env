# Copied to config.local.env by `mise run cluster:init` on the controller.
# This file is sourced by POSIX shell, so keep values shell-safe and quoted.

# Apple's topology utility SSHes to every rank, including rank 0. Both aliases
# are installed by `mise run cluster:ssh-setup`.
CLUSTER_CONTROLLER_ALIAS="mlx-m5"
CLUSTER_CONTROLLER_HOST="localhost"
CLUSTER_CONTROLLER_USER="dustinmays"
CLUSTER_CONTROLLER_SSH="mlx-m5"
CLUSTER_WORKER_ALIAS="mlx-m4"
CLUSTER_WORKER_HOST="Dustins-MacBook-Pro.local"
CLUSTER_WORKER_USER="dustin"
CLUSTER_WORKER_REPO="/Users/dustin/repos/local-llm"

# Ring uses TCP over the direct Thunderbolt link and is the safe default for
# this pair. JACCL is faster but caused kernel panics during initialization;
# see README.md and docs/CLUSTER.md before opting into it.
CLUSTER_BACKEND="ring"
CLUSTER_TRANSPORT="thunderbolt"

# Model profile defaults are shared by both Macs in cluster/models.env.
# Override them here only if you make the same model available to both ranks.
# CLUSTER_MODEL_FAST="mlx-community/..."
# CLUSTER_MODEL_OVERNIGHT="mlx-community/..."

# Rank 0 exposes the OpenAI-compatible API only to the local Mac.
CLUSTER_API_HOST="127.0.0.1"
CLUSTER_API_PORT="8080"
CLUSTER_MAX_OUTPUT_TOKENS="4096"
CLUSTER_PROMPT_CACHE_SIZE="1"
CLUSTER_PROMPT_CACHE_BYTES="4294967296"

# The same absolute path must resolve to this repository on both Macs.
CLUSTER_SHARED_ROOT="/Users/Shared/local-llm"
CLUSTER_SSH_KEY="$HOME/.ssh/id_ed25519_local_llm_cluster"
