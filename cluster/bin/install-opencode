#!/bin/bash

set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd -P)/lib/common.sh"
cluster_load_config

destination="${OPENCODE_CONFIG_DESTINATION:-$HOME/.config/opencode/opencode.json}"
mkdir -p "$(dirname "$destination")"
if [ -f "$destination" ]; then
  backup="$destination.backup-$(date +%Y%m%d-%H%M%S)"
  cp -p "$destination" "$backup"
  cluster_note "backed up existing config to $backup"
fi
cluster_python - "$CLUSTER_REPO_ROOT/config/opencode.json" "$destination" "$CLUSTER_MODEL_FAST" "$CLUSTER_MODEL_OVERNIGHT" "$CLUSTER_MODEL_TEST" <<'PY'
import json
import sys

source, destination, fast_model, overnight_model, test_model = sys.argv[1:]
with open(source) as handle:
    config = json.load(handle)

def entry(model, suffix, context):
    label = model.rsplit("/", 1)[-1].replace("-", " ")
    return {
        "name": f"{label} ({suffix})",
        "limit": {"context": context, "output": 4096},
    }

config["provider"]["mlxcluster"]["models"] = {
    fast_model: entry(fast_model, "fast distributed", 32768),
    overnight_model: entry(overnight_model, "overnight distributed", 32768),
    test_model: entry(test_model, "cluster test", 8192),
}
with open(destination, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
PY
cluster_note "installed OpenCode config at $destination"
cluster_note "fast model: $CLUSTER_MODEL_FAST"
cluster_note "overnight model: $CLUSTER_MODEL_OVERNIGHT"
