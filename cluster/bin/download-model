#!/bin/bash

set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd -P)/lib/common.sh"
cluster_load_models

profile="${1:---fast}"
profile="${profile#--}"
model="$(cluster_model_for_profile "$profile")"

cluster_note "downloading $profile model on $(scutil --get LocalHostName 2>/dev/null || hostname)"
cluster_note "$model"
caffeinate -ims "$(cluster_mise)" -C "$CLUSTER_REPO_ROOT" exec -- python -c \
  'from huggingface_hub import snapshot_download; import sys; print(snapshot_download(sys.argv[1]))' \
  "$model"
cluster_note "$profile model is present on this Mac"
