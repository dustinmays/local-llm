#!/bin/bash

set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd -P)/lib/common.sh"
cluster_load_config

cluster_note "preparing $CLUSTER_WORKER_SSH"
cluster_remote "
  set -e
  if [ ! -x /opt/homebrew/bin/mise ] && ! command -v mise >/dev/null 2>&1; then
    echo 'worker: mise is missing; install it with: brew install mise' >&2
    exit 1
  fi
  if [ ! -d '$CLUSTER_WORKER_REPO/.git' ]; then
    echo 'worker: repository clone is missing at $CLUSTER_WORKER_REPO' >&2
    echo 'worker: clone it from an interactive M4 terminal, then rerun this task' >&2
    exit 1
  fi
  cd '$CLUSTER_WORKER_REPO'
  if [ -x /opt/homebrew/bin/mise ]; then mise_bin=/opt/homebrew/bin/mise; else mise_bin=\$(command -v mise); fi
  \"\$mise_bin\" trust mise.toml >/dev/null
  \"\$mise_bin\" install
  \"\$mise_bin\" run setup
"

cluster_note "worker setup complete"
