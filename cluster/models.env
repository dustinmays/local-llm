# Shared model profile defaults. This tracked file is available on both Macs.
# Values may be overridden after sourcing it, but both ranks must use the same
# exact Hugging Face repository for a distributed launch.

CLUSTER_MODEL_FAST="${CLUSTER_MODEL_FAST:-mlx-community/Qwen3.5-35B-A3B-4bit}"
CLUSTER_MODEL_OVERNIGHT="${CLUSTER_MODEL_OVERNIGHT:-mlx-community/Qwen3.5-122B-A10B-4bit}"
CLUSTER_MODEL_TEST="${CLUSTER_MODEL_TEST:-mlx-community/Llama-3.2-3B-Instruct-4bit}"

# Cache repositories removed by the guarded local cleanup task.
CLUSTER_LLAMA_CLEANUP_MODELS="${CLUSTER_LLAMA_CLEANUP_MODELS:-mlx-community/Llama-3.2-3B-Instruct-4bit mlx-community/Llama-3.3-70B-Instruct-4bit}"
